# Copy to .env.local and fill in. Never commit .env.local.

# Public values: shipped to the browser. Safe to expose; access is enforced by RLS.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# Local tooling only (migrations, seed, permission tests). Never set this on Vercel.
# Use the "Session pooler" connection string from Supabase > Connect.
DATABASE_URL=postgresql://postgres.YOUR-PROJECT-REF:YOUR-PASSWORD@aws-0-us-east-1.pooler.supabase.com:5432/postgres
